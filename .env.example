# ========================================================
# HEADLESS WHATSAPP PDF RELAY — ENVIRONMENT CONFIGURATION
# ========================================================

# 1. MongoDB Atlas Free Database URI
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/whatsapp_bot?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/whatsapp_bot?retryWrites=true&w=majority

# 2. Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiAPIKeyHere

# 3. College WhatsApp Group JID (e.g., 123456789012345678@g.us)
# Leave blank on first startup to see all your group JIDs printed in console logs!
TARGET_GROUP_JID=

# 4. Print Shop WhatsApp Number formatted as JID (e.g., 919876543210@s.whatsapp.net)
PRINT_SHOP_JID=919876543210@s.whatsapp.net

# 5. Express Port (Render sets this automatically in production)
PORT=3000
